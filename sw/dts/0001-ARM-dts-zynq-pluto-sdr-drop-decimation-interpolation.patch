From 7a177007a055dc2eb003d13b58b709c70f83f4ca Mon Sep 17 00:00:00 2001
From: Takuji Ebinuma <takuji.ebinuma@gmail.com>
Date: Mon, 9 Nov 2026 11:50:31 +0900
Subject: [PATCH 1/3] ARM: dts: zynq-pluto-sdr: drop decimation/interpolation
 core flags

The pluto-crpa HDL (hdl crpa branch) removes the rx_fir_decimator and
tx_fir_interpolator blocks, so the f/8 rate offered by the
cf-ad9361-lpc and cf-ad9361-dds-core-lpc drivers no longer exists in
hardware. Without these properties the ADC driver no longer offers f/8
and passes sampling_frequency writes to the AD9361 clock, and the DDS
driver does not create the interpolation attributes.
---
 arch/arm/boot/dts/xilinx/zynq-pluto-sdr.dtsi | 2 --
 1 file changed, 2 deletions(-)

diff --git a/arch/arm/boot/dts/xilinx/zynq-pluto-sdr.dtsi b/arch/arm/boot/dts/xilinx/zynq-pluto-sdr.dtsi
index 4c102e7de7e3..4277e0121bb8 100644
--- a/arch/arm/boot/dts/xilinx/zynq-pluto-sdr.dtsi
+++ b/arch/arm/boot/dts/xilinx/zynq-pluto-sdr.dtsi
@@ -132,7 +132,6 @@ cf_ad9364_adc_core_0: cf-ad9361-lpc@79020000 {
 			dmas = <&rx_dma 0>;
 			dma-names = "rx";
 			spibus-connected = <&adc0_ad9364>;
-			adi,axi-decimation-core-available;
 		};
 
 		cf_ad9364_dac_core_0: cf-ad9361-dds-core-lpc@79024000 {
@@ -142,7 +141,6 @@ cf_ad9364_dac_core_0: cf-ad9361-dds-core-lpc@79024000 {
 			clock-names = "sampl_clk";
 			dmas = <&tx_dma 0>;
 			dma-names = "tx";
-			adi,axi-interpolation-core-available;
 			adi,axi-dds-default-scale = <0>;
 		};
 
